{
  "name": "xray-evidence-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm --workspace apps/web run build",
    "dev": "npm --workspace apps/web run dev",
    "e2e": "npm --workspace apps/web run e2e",
    "e2e:live": "npm --workspace apps/web run e2e:live",
    "generate:api": "npm --workspace apps/web run generate:api",
    "lint": "npm --workspace apps/web run lint",
    "test": "npm --workspace apps/web test",
    "typecheck": "npm --workspace apps/web run typecheck"
  }
}
